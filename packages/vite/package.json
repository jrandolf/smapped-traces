{
  "name": "@smapped-traces/vite",
  "version": "0.1.2",
  "description": "Vite source map collection for smapped-traces",
  "keywords": [
    "vite",
    "sveltekit",
    "opentelemetry",
    "otel",
    "source-map",
    "sourcemap",
    "error-tracking"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mathematic-inc/smapped-traces.git",
    "directory": "packages/vite"
  },
  "license": "Apache-2.0",
  "author": "Mathematic Inc",
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "build",
    "src",
    "!src/**/*.test.ts",
    "!build/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.lib.json",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "fast-glob": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "smapped-traces": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "smapped-traces": "workspace:^",
    "vite": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
